meta {
  name: Neural (semantic) search
  type: http
  seq: 14
}

docs {
search_pipeline applies neural_query_enricher, so model_id is omitted from the body.
}

get {
  url: {{baseUrl}}/vector-search-index/_search?search_pipeline=default-model-pipeline
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "_source": { "excludes": ["passage_embedding"] },
    "query": {
      "neural": {
        "passage_embedding": {
          "query_text": "an ambitious scientist who comes to regret his own creation",
          "k": 10
        }
      }
    }
  }
}
