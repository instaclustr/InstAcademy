meta {
  name: Dense only (Chapter 2 index, optional)
  type: http
  seq: 14
}

docs {
Reuses Chapter 2's vector-search-index and dense model (modelId). Skip if Chapter 2 was torn down.
}

get {
  url: {{baseUrl}}/vector-search-index/_search?filter_path=hits.hits._id,hits.hits._score,hits.hits._source,hits.hits.highlight
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "_source": [
      "title"
    ],
    "size": 5,
    "query": {
      "neural": {
        "passage_embedding": {
          "query_text": "a hero on a dangerous sea voyage",
          "model_id": "{{modelId}}",
          "k": 10
        }
      }
    },
    "highlight": {
      "fields": {
        "passage_text": {
          "fragment_size": 120,
          "number_of_fragments": 1
        }
      },
      "highlight_query": {
        "match": {
          "passage_text": "a hero on a dangerous sea voyage"
        }
      }
    }
  }
}
