meta {
  name: Create on_disk demo index
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/vector-disk-demo
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "settings": { "index": { "knn": true } },
    "mappings": {
      "properties": {
        "my_vector": {
          "type": "knn_vector",
          "dimension": 8,
          "space_type": "l2",
          "mode": "on_disk",
          "compression_level": "16x"
        }
      }
    }
  }
}
