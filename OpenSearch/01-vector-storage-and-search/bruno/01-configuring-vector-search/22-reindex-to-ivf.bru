meta {
  name: Reindex products into IVF index
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/_reindex?wait_for_completion=true
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "source": { "index": "products-hnsw" },
    "dest": { "index": "products-ivf" }
  }
}
