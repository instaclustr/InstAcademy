# OpenSearch cluster connection (optional — for Python reference scripts)
# Learn mode uses Dev Tools / Bruno; copy the same values into bruno/environments/Local.bru

OPENSEARCH_HOST=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Set after Chapter 2 Lesson 1 (dense) or Chapter 3/4 model deploy
ML_MODEL_ID=

# Optional — Chapter 4 register model if not passing model_group_id on CLI
ML_MODEL_GROUP_ID=

# Optional — Chapter 4 hybrid search pipeline override
BOOKSTORE_HYBRID_PIPELINE=bookstore-hybrid-pipeline
