meta {
  name: Shrink to bookstore-rag-shrunk
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/bookstore-rag-split/_shrink/bookstore-rag-shrunk
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "index.number_of_shards": 1,
    "index.number_of_replicas": 1,
    "index.codec": "best_compression"
  }
}
}
