meta {
  name: Create ISM lifecycle policy
  type: http
  seq: 37
}

put {
  url: {{baseUrl}}/_plugins/_ism/policies/bookstore-searches-policy
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "policy": {
    "description": "Roll over daily/50gb, delete after 90 days",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_size": "50gb",
              "min_index_age": "30d"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "90d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "searches-*"
        ],
        "priority": 100
      }
    ]
  }
}
}
