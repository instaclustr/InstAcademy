meta {
  name: Create reindex destination my-index-new
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/my-index-new
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    }
  },
  "mappings": {
    "properties": {
      "book_id": {
        "type": "keyword"
      },
      "title": {
        "type": "text"
      },
      "isbn": {
        "type": "keyword"
      },
      "genre": {
        "type": "keyword"
      },
      "description": {
        "type": "text"
      },
      "price": {
        "type": "float"
      },
      "in_stock": {
        "type": "boolean"
      },
      "published_year": {
        "type": "integer"
      }
    }
  }
}
}
