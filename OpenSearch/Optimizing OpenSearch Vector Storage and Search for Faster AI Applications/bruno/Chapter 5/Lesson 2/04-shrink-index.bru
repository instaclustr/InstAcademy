meta {
  name: Shrink step 2: shrink index
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/bookstore-rag-all-together/_shrink/bookstore-rag-all-together-shrunk
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "index.number_of_shards": 1,
    "index.number_of_replicas": 1,
    "index.codec": "best_compression"
  }
}
}
