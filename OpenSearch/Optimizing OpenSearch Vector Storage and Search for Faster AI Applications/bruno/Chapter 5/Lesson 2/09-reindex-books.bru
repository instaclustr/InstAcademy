meta {
  name: Reindex my-index to my-index-new with script
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/_reindex?slices=5&wait_for_completion=true
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "source": { "index": "my-index" },
  "dest": { "index": "my-index-new" },
  "script": {
    "source": "ctx._source.title = ctx._source.title + ' ' + ctx._source.author; ctx._source.remove('author');",
    "lang": "painless"
  }
}
}
