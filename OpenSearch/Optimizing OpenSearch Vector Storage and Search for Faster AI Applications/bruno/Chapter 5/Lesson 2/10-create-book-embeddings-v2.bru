meta {
  name: Create book-embeddings-v2 index
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/book-embeddings-v2
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "index.knn": true
  },
  "mappings": {
    "properties": {
      "book_id": { "type": "keyword" },
      "title": { "type": "text" },
      "embedding": {
        "type": "knn_vector",
        "dimension": 768,
        "method": {
          "name": "hnsw",
          "space_type": "l2",
          "engine": "faiss",
          "parameters": { "ef_construction": 128, "m": 16 }
        }
      },
      "model_version": { "type": "keyword" },
      "created_at": { "type": "date" }
    }
  }
}
}
