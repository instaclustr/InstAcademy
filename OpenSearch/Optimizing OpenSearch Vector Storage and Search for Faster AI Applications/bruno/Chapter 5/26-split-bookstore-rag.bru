meta {
  name: Split bookstore-rag into bookstore-rag-split (prerequisite fix)
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/bookstore-rag/_split/bookstore-rag-split
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "index.number_of_shards": 2,
    "index.number_of_replicas": 1
  }
}
}
