meta {
  name: Create least-privilege read-only role
  type: http
  seq: 50
}

put {
  url: {{baseUrl}}/_plugins/_security/api/roles/bookstore_read_only
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "cluster_permissions": [
    "cluster_composite_ops_ro"
  ],
  "index_permissions": [
    {
      "index_patterns": [
        "books*",
        "bookstore-rag*",
        "vector-search-index"
      ],
      "allowed_actions": [
        "read",
        "indices:data/read/search",
        "indices:data/read/get"
      ]
    }
  ]
}
}
