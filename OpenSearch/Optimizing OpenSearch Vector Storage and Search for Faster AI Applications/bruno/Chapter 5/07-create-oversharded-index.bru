meta {
  name: Create deliberately over-sharded my-index
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/my-index
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "number_of_shards": 6,
    "number_of_replicas": 3
  }
}
}
