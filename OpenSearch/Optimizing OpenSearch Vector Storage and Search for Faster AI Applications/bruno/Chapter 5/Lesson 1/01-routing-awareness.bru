meta {
  name: Cluster routing awareness settings
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/_cluster/settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "persistent": {
    "cluster.routing.allocation.awareness.attributes": "zone",
    "cluster.routing.allocation.awareness.force.zone.values": "zone1,zone2,zone3"
  }
}
}
