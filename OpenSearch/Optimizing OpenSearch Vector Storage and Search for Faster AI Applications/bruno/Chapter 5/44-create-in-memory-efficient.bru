meta {
  name: Create in_memory efficient index
  type: http
  seq: 44
}

put {
  url: {{baseUrl}}/book-embeddings-efficient
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": {
    "index.knn": true
  },
  "mappings": {
    "properties": {
      "embedding": {
        "type": "knn_vector",
        "dimension": 768,
        "space_type": "l2",
        "data_type": "float",
        "mode": "in_memory"
      }
    }
  }
}
}
