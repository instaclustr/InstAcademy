meta {
  name: Register neural sparse encoding model
  type: http
  seq: 3
}

docs {
Bi-encoder model (needs model_id at query time). On the register response, set taskId, poll 04 until COMPLETED, then save model_id to sparseModelId.
}

post {
  url: {{baseUrl}}/_plugins/_ml/models/_register
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "name": "amazon/neural-sparse/opensearch-neural-sparse-encoding-v1",
  "version": "1.0.1",
  "model_group_id": "{{modelGroupId}}",
  "model_format": "TORCH_SCRIPT"
}
}
