meta {
  name: Hybrid search (normalized)
  type: http
  seq: 16
}

docs {
BM25 + neural_sparse fused by score normalization. Save the top-5 order to compare with RRF.
}

get {
  url: {{baseUrl}}/my-sparse-neural-index/_search?search_pipeline=nlp-search-normalization-pipeline&filter_path=hits.hits._id,hits.hits._score,hits.hits._source,hits.hits.highlight
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "_source": [
      "title"
    ],
    "size": 5,
    "query": {
      "hybrid": {
        "queries": [
          {
            "match": {
              "passage_text": {
                "query": "a hero on a dangerous sea voyage"
              }
            }
          },
          {
            "nested": {
              "path": "passage_embedding",
              "score_mode": "max",
              "query": {
                "neural_sparse": {
                  "passage_embedding.sparse_encoding": {
                    "query_text": "a hero on a dangerous sea voyage",
                    "model_id": "{{sparseModelId}}"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "highlight": {
      "fields": {
        "passage_text": {
          "fragment_size": 120,
          "number_of_fragments": 1
        }
      },
      "highlight_query": {
        "match": {
          "passage_text": "a hero on a dangerous sea voyage"
        }
      }
    }
  }
}
