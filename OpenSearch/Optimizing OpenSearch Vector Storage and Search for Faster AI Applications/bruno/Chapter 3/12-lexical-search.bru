meta {
  name: Lexical only (BM25 match)
  type: http
  seq: 12
}

docs {
Keyword-only baseline. Save the top-5 order to compare against sparse, hybrid, and RRF.
}

get {
  url: {{baseUrl}}/my-sparse-neural-index/_search?filter_path=hits.hits._id,hits.hits._score,hits.hits._source,hits.hits.highlight
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "_source": ["title"],
    "size": 5,
    "query": {
      "match": {
        "passage_text": "a hero on a dangerous sea voyage"
      }
    },
    "highlight": {
      "fields": { "passage_text": { "fragment_size": 120, "number_of_fragments": 1 } }
    }
  }
}
