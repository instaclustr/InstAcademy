meta {
  name: Sparse only (neural_sparse)
  type: http
  seq: 13
}

docs {
Semantic sparse retrieval. Doc-only models: drop model_id and use "analyzer": "bert-uncased".
}

post {
  url: {{baseUrl}}/my-sparse-neural-index/_search
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "_source": { "excludes": ["passage_embedding", "passage_chunk"] },
  "size": 5,
  "query": {
    "nested": {
      "path": "passage_embedding",
      "score_mode": "max",
      "query": {
        "neural_sparse": {
          "passage_embedding.sparse_encoding": {
            "query_text": "a hero on a dangerous sea voyage",
            "model_id": "{{sparseModelId}}"
          }
        }
      }
    }
  }
}
}
