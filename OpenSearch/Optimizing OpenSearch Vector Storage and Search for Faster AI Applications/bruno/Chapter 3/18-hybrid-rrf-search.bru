meta {
  name: Hybrid search (RRF)
  type: http
  seq: 18
}

docs {
Identical query body to 16 — only the search_pipeline changes. Compare the RRF order to the normalized order.
}

get {
  url: {{baseUrl}}/my-sparse-neural-index/_search?search_pipeline=rrf-search-pipeline
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "_source": { "excludes": ["passage_embedding", "passage_chunk"] },
  "size": 5,
  "query": {
    "hybrid": {
      "queries": [
        { "match": { "passage_text": { "query": "a hero on a dangerous sea voyage" } } },
        {
          "nested": {
            "path": "passage_embedding",
            "score_mode": "max",
            "query": {
              "neural_sparse": {
                "passage_embedding.sparse_encoding": {
                  "query_text": "a hero on a dangerous sea voyage",
                  "model_id": "{{sparseModelId}}"
                }
              }
            }
          }
        }
      ]
    }
  }
}
}
