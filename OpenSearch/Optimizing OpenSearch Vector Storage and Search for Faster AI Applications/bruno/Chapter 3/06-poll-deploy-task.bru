meta {
  name: Poll ML task (deploy)
  type: http
  seq: 6
}

docs {
Run repeatedly until state is COMPLETED. Set taskId from the deploy response.
}

get {
  url: {{baseUrl}}/_plugins/_ml/tasks/{{taskId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
