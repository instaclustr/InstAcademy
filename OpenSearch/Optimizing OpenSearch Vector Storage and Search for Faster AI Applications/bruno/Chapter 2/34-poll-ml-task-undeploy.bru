meta {
  name: Poll ML task (undeploy)
  type: http
  seq: 34
}

docs {
Run repeatedly until state is terminal. Set taskId from the undeploy response.
}

get {
  url: {{baseUrl}}/_plugins/_ml/tasks/{{taskId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
