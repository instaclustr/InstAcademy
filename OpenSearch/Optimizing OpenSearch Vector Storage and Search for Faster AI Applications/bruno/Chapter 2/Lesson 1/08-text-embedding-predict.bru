meta {
  name: Text embedding predict
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/_plugins/_ml/_predict/text_embedding/{{modelId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "text_docs": ["historical fiction with an underdog story"],
  "target_response": ["sentence_embedding"]
}
}
