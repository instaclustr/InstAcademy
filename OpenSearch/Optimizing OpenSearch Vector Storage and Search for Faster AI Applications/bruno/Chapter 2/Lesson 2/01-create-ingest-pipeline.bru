meta {
  name: Create vector-search-embeddings-pipeline
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/_ingest/pipeline/vector-search-embeddings-pipeline
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "description": "Pipeline for processing OpenSearch index data",
  "processors": [
    {
      "text_embedding": {
        "model_id": "{{modelId}}",
        "field_map": {
          "passage_text": "passage_embedding"
        }
      }
    }
  ]
}
}
