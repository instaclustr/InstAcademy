meta {
  name: Sparse encoding predict
  type: http
  seq: 18
}

docs {
Optional (Lesson 2-3). Output is a token->weight map, not a fixed-length float array.
}

post {
  url: {{baseUrl}}/_plugins/_ml/_predict/sparse_encoding/{{sparseModelId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "text_docs": ["today is sunny"]
}
}
