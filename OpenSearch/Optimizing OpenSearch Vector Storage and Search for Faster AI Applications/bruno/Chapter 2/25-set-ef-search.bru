meta {
  name: Set ef_search
  type: http
  seq: 25
}

docs {
ANN candidate-list size. Higher = better recall, slower search. Dynamic.
}

put {
  url: {{baseUrl}}/vector-search-index/_settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "index.knn.algo_param.ef_search": 100
}
}
