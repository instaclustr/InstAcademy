meta {
  name: Register msmarco-distilbert model
  type: http
  seq: 4
}

docs {
If response has task_id, set taskId and poll (05). On COMPLETED, save model_id to modelId.
}

post {
  url: {{baseUrl}}/_plugins/_ml/models/_register
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "name": "huggingface/sentence-transformers/msmarco-distilbert-base-tas-b",
  "version": "1.0.3",
  "model_group_id": "{{modelGroupId}}",
  "model_format": "TORCH_SCRIPT"
}
}
