meta {
  name: Cluster routing allocation and rebalance
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/_cluster/settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "persistent": {
    "cluster.routing.allocation.enable": "all",
    "cluster.routing.rebalance.enable": "all"
  }
}
}
