meta {
  name: Poll ML task
  type: http
  seq: 5
}

docs {
Run repeatedly after register/deploy until state is COMPLETED. Set taskId from the previous response. Copy model_id when done.
}

get {
  url: {{baseUrl}}/_plugins/_ml/tasks/{{taskId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
