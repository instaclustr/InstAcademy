meta {
  name: Force merge segments
  type: http
  seq: 24
}

docs {
Run after heavy ingest to consolidate segments. Can take a while.
}

post {
  url: {{baseUrl}}/vector-search-index/_forcemerge?max_num_segments=1
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
