meta {
  name: Register all-mpnet-base-v2 model
  type: http
  seq: 3
}

docs {
On COMPLETED, save model_id to modelId.
}

post {
  url: {{baseUrl}}/_plugins/_ml/models/_register
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "name": "huggingface/sentence-transformers/all-mpnet-base-v2",
  "version": "1.0.1",
  "model_group_id": "{{modelGroupId}}",
  "model_format": "TORCH_SCRIPT"
}
}
