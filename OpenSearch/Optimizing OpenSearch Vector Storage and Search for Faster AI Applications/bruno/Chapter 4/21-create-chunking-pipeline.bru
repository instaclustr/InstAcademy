meta {
  name: Create chunking ingest pipeline
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/_ingest/pipeline/bookstore-chunking-pipeline
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "description": "Chunk and embed book content for RAG",
  "processors": [
    {
      "text_chunking": {
        "algorithm": {
          "fixed_token_length": {
            "token_limit": 384,
            "overlap_rate": 0.2,
            "tokenizer": "standard"
          }
        },
        "field_map": {
          "content": "content_chunks"
        }
      }
    },
    {
      "script": {
        "lang": "painless",
        "source": "if (ctx.content_chunks == null) { ctx.content_chunks = []; } else { def n = []; for (int i = 0; i < ctx.content_chunks.size(); i++) { def c = ctx.content_chunks.get(i); if (c != null) { n.add(['text': c, 'chunk_index': i]); } } ctx.content_chunks = n; }"
      }
    },
    {
      "text_embedding": {
        "model_id": "{{modelId}}",
        "field_map": {
          "content": "content_embedding"
        }
      }
    }
  ]
}
}
