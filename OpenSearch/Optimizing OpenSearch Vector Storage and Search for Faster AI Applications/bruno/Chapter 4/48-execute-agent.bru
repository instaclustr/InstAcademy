meta {
  name: Execute the bookstore agent (optional)
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/_plugins/_ml/agents/{{agentId}}/_execute
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "parameters": {
    "question": "Find me highly rated mystery novels published after 2020 that are currently in stock"
  }
}
}
