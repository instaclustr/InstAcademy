            "content": "detective mystery investigation"
          }
        }
      },
      "ratings": [
        {
          "_index": "bookstore-rag",
          "_id": "1661",
          "rating": 3
        }
      ]
    },
    {
      "id": "gothic_query",
      "request": {
        "query": {
          "match": {
            "content": "gothic horror monster"
          }
        }
      },
      "ratings": [
