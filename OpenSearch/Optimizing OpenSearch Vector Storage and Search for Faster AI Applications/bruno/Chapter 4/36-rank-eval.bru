meta {
  name: Rank evaluation (MRR@10)
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/bookstore-rag/_rank_eval
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
