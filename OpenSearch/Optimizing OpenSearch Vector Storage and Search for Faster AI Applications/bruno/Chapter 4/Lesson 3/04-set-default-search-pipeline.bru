meta {
  name: Set default search pipeline on bookstore-rag
  type: http
  seq: 4
}

docs {
Requires bookstore-stock-filter pipeline to exist.
}

put {
  url: {{baseUrl}}/bookstore-rag/_settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{"index.search.default_pipeline": "bookstore-stock-filter"}
}
