meta {
  name: Enable URL model registration
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/_cluster/settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "persistent": {
    "plugins.ml_commons.allow_registering_model_via_url": true
  }
}
}
