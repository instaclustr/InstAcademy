meta {
  name: Set vector file preload
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/bookstore-rag/_settings
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "index": {
      "store": {
        "preload": [
          "vec",
          "vem"
        ]
      }
    }
  }
}
