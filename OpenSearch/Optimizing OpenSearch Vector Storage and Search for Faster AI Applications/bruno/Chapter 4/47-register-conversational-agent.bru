meta {
  name: Register conversational agent (optional)
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/_plugins/_ml/agents/_register
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "name": "Bookstore Search Agent",
  "type": "conversational",
  "description": "AI agent for bookstore search and recommendations",
  "llm": {
    "model_id": "{{modelId}}",
    "parameters": {
      "max_iteration": 10,
      "response_filter": "$.choices[0].message.content"
    }
  },
  "memory": {
    "type": "conversation_index"
  },
  "parameters": {
    "_llm_interface": "openai/v1/chat/completions"
  },
  "tools": [
    {
      "type": "ListIndexTool",
      "name": "ListIndexTool"
    },
    {
      "type": "IndexMappingTool",
      "name": "IndexMappingTool"
    },
    {
      "type": "SearchIndexTool",
      "name": "SearchIndexTool",
      "parameters": {
        "input": "${parameters.question}"
      }
    },
    {
      "type": "QueryPlanningTool"
    }
  ],
  "app_type": "os_chat"
}
}
