meta {
  name: Reindex with vector truncation
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/_reindex?wait_for_completion=true
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "source": { "index": "my-vector-index" },
  "dest": { "index": "my-optimized-vector-index" },
  "script": {
    "source": "ctx._source.my_vector = ctx._source.my_vector.subList(0, 128);",
    "lang": "painless"
  }
}
}
