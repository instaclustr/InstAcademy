meta {
  name: Bulk index sample books
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/_bulk
  body: file
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:file {
file: ../../../rest/bulk/chapter-1-keyword-index-sample.ndjson
  contentType: application/x-ndjson
}
