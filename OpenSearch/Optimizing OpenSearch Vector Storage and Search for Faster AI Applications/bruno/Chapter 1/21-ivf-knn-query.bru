meta {
  name: IVF knn query (nprobes)
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/products-ivf/_search
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "size": 3,
  "query": {
    "knn": {
      "product_vector": {
        "vector": [0.90, 0.90, 0.10, 0.10, 0.05, 0.05, 0.10, 0.10],
        "k": 3,
        "method_parameters": { "nprobes": 4 }
      }
    }
  }
}
}
