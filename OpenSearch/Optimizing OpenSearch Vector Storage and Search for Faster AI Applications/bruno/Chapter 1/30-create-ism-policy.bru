meta {
  name: Create ISM rollover policy
  type: http
  seq: 30
}

put {
  url: {{baseUrl}}/_plugins/_ism/policies/vector-rollover-policy
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "policy": {
    "description": "Roll vector indexes over by size or age to keep shards healthy",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          { "rollover": { "min_size": "10gb", "min_index_age": "1d" } }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["vector-logs-*"], "priority": 100 }
    ]
  }
}
}
