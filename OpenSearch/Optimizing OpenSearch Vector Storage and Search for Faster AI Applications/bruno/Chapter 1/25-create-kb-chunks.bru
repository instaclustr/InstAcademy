meta {
  name: Create kb-chunks index
  type: http
  seq: 25
}

put {
  url: {{baseUrl}}/kb-chunks
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "settings": { "index": { "knn": true } },
  "mappings": {
    "properties": {
      "parent_id": { "type": "keyword" },
      "chunk_text": { "type": "text" },
      "chunk_vector": {
        "type": "knn_vector",
        "dimension": 8,
        "space_type": "l2",
        "method": { "name": "hnsw", "engine": "faiss" }
      }
    }
  }
}
}
