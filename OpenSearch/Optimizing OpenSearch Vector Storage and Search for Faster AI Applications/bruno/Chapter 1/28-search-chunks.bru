meta {
  name: Retrieve nearest chunks
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/kb-chunks/_search
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "size": 3,
  "_source": ["parent_id", "chunk_text"],
  "query": {
    "knn": {
      "chunk_vector": {
        "vector": [0.88, 0.12, 0.12, 0.10, 0.10, 0.10, 0.11, 0.10],
        "k": 3
      }
    }
  }
}
}
