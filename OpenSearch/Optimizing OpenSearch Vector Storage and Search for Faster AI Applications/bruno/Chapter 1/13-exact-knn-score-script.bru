meta {
  name: Exact k-NN (knn_score script)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/products-hnsw/_search
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
{
  "size": 3,
  "query": {
    "script_score": {
      "query": { "match_all": {} },
      "script": {
        "source": "knn_score",
        "lang": "knn",
        "params": {
          "field": "product_vector",
          "query_value": [0.90, 0.90, 0.10, 0.10, 0.05, 0.05, 0.10, 0.10],
          "space_type": "l2"
        }
      }
    }
  }
}
}
