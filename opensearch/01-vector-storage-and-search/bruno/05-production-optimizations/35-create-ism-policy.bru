meta {
  name: Create ISM lifecycle policy
  type: http
  seq: 35
}

put {
  url: {{baseUrl}}/_plugins/_ism/policies/bookstore-searches-policy
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "policy": {
      "description": "Demo: roll over at 5 docs, delete after 90 days",
      "default_state": "hot",
      "states": [
        {
          "name": "hot",
          "actions": [ { "rollover": { "min_doc_count": 5 } } ],
          "transitions": [ { "state_name": "delete", "conditions": { "min_index_age": "90d" } } ]
        },
        {
          "name": "delete",
          "actions": [ { "delete": {} } ],
          "transitions": []
        }
      ],
      "ism_template": [ { "index_patterns": [ "searches-*" ], "priority": 100 } ]
    }
  }
}
