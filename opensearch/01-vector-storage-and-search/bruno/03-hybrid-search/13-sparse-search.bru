meta {
  name: Sparse only (neural_sparse)
  type: http
  seq: 13
}

docs {
Semantic sparse retrieval. Doc-only models: drop model_id and use "analyzer": "bert-uncased".
}

get {
  url: {{baseUrl}}/my-sparse-neural-index/_search?filter_path=hits.hits._id,hits.hits._score,hits.hits._source,hits.hits.highlight
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "_source": [
      "title"
    ],
    "size": 5,
    "query": {
      "nested": {
        "path": "passage_embedding",
        "score_mode": "max",
        "query": {
          "neural_sparse": {
            "passage_embedding.sparse_encoding": {
              "query_text": "a hero on a dangerous sea voyage",
              "model_id": "{{sparseModelId}}"
            }
          }
        }
      }
    },
    "highlight": {
      "fields": {
        "passage_text": {
          "fragment_size": 120,
          "number_of_fragments": 1
        }
      },
      "highlight_query": {
        "match": {
          "passage_text": "a hero on a dangerous sea voyage"
        }
      }
    }
  }
}
