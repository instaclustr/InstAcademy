meta {
  name: Create hybrid search pipeline
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/_search/pipeline/bookstore-hybrid-pipeline
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "description": "Hybrid search pipeline for bookstore RAG",
    "phase_results_processors": [
      {
        "normalization-processor": {
          "normalization": {
            "technique": "min_max"
          },
          "combination": {
            "technique": "arithmetic_mean",
            "parameters": {
              "weights": [
                0.3,
                0.7
              ]
            }
          }
        }
      }
    ]
  }
}
