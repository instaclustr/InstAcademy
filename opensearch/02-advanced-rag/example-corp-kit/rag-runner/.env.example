# Advanced RAG lab configuration for the runner.
# Copy this file to ".env" in this same folder and fill in your values.
# The scripts load .env automatically, so you do not retype anything.
# Do NOT commit or share .env: it holds your cluster password.
# Real environment variables, if set, take precedence over .env.

OS_URL=https://your-load-balancer-host:9200
OS_USER=your-opensearch-user
OS_PW=your-opensearch-password

# Which index the runner queries, and how it retrieves.
#
# RAG_INDEX  the knowledge base you build in Chapter 1.
#
# RAG_PIPE   the hybrid search pipeline you build in Chapter 3 Step 5.
#            LEAVE IT COMMENTED OUT UNTIL THEN. Unset, the runner retrieves
#            with a single-leg vector search, which is the system Chapter 2
#            builds. Chapter 3 Step 9 asks you to uncomment it and compare
#            the same questions through a fused retriever.
RAG_INDEX=support-advrag-kb
# RAG_PIPE=support-advrag-hybrid

# Which model writes the answers: "groq" or "ollama".
# Whichever you choose, if its key is missing the runner falls back to Ollama
# rather than refusing to start.
#
# groq    THE COURSE DEFAULT. A free key from https://console.groq.com/keys,
#         no payment details. Its free tier allows around a thousand requests
#         a day, and a full pass through the course is about twenty.
#
# ollama  runs on your own machine, no key and no quota. A 3B model does not
#         hold the five-block prompt this course teaches: handed a question
#         the evidence does not cover, it tends to invent an answer where a
#         larger model declines. Chapter 2 has an optional step that runs it
#         on purpose so you can see that difference for yourself.
LLM_BACKEND=groq
GROQ_API_KEY=your-groq-key

# Optional model override (default shown):
# GROQ_MODEL=openai/gpt-oss-120b

# Which local Ollama model generates the answers when LLM_BACKEND=ollama:
OLLAMA_MODEL=llama3.2:3b

# Optional overrides (defaults shown):
# OLLAMA_URL=http://localhost:11434
# RAG_PORT=8787

# A third backend, Google AI Studio, is also wired up but is not part of the
# course path: its free tier is only 20 requests per day per model, which is
# less than one pass through the course.
# LLM_BACKEND=gemini
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash
