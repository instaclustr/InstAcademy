{
  "title": "Example Corp Platform API v2",
  "auth": "All endpoints require a service account bearer token in the Authorization header. Rate limit: 600 requests per minute per service account. Exceeding it returns HTTP 429 with error code ERR-6601.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v2/dashboards",
      "summary": "List dashboards",
      "params": [
        {
          "name": "workspace_id",
          "type": "string",
          "required": true
        },
        {
          "name": "page",
          "type": "integer",
          "required": false
        },
        {
          "name": "page_size",
          "type": "integer",
          "required": false
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/dashboards/{dashboard_id}",
      "summary": "Get a dashboard",
      "params": [
        {
          "name": "dashboard_id",
          "type": "string",
          "required": true
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/dashboards/{dashboard_id}/export",
      "summary": "Export a dashboard to PDF",
      "params": [
        {
          "name": "dashboard_id",
          "type": "string",
          "required": true
        },
        {
          "name": "format",
          "type": "string",
          "required": false
        },
        {
          "name": "dpi",
          "type": "integer",
          "required": false
        }
      ],
      "errors": [
        "ERR-1210",
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/embed/urls",
      "summary": "Create a signed embed URL",
      "params": [
        {
          "name": "dashboard_id",
          "type": "string",
          "required": true
        },
        {
          "name": "user_attributes",
          "type": "object",
          "required": false
        },
        {
          "name": "expires_in",
          "type": "integer",
          "required": false
        }
      ],
      "errors": [
        "ERR-6640",
        "ERR-6601"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/datasets",
      "summary": "List datasets",
      "params": [
        {
          "name": "workspace_id",
          "type": "string",
          "required": true
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/datasets/{dataset_id}/refresh",
      "summary": "Trigger a dataset refresh",
      "params": [
        {
          "name": "dataset_id",
          "type": "string",
          "required": true
        },
        {
          "name": "mode",
          "type": "string",
          "required": false
        }
      ],
      "errors": [
        "ERR-3305",
        "ERR-6601"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/datasets/{dataset_id}/refresh/{job_id}",
      "summary": "Get refresh status",
      "params": [
        {
          "name": "dataset_id",
          "type": "string",
          "required": true
        },
        {
          "name": "job_id",
          "type": "string",
          "required": true
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/connectors",
      "summary": "List connectors",
      "params": [
        {
          "name": "workspace_id",
          "type": "string",
          "required": true
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/connectors/{connector_id}/test",
      "summary": "Test a connector",
      "params": [
        {
          "name": "connector_id",
          "type": "string",
          "required": true
        }
      ],
      "errors": [
        "ERR-2209",
        "ERR-2231",
        "ERR-2288"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/alerts",
      "summary": "Create an alert",
      "params": [
        {
          "name": "dashboard_id",
          "type": "string",
          "required": true
        },
        {
          "name": "condition",
          "type": "object",
          "required": true
        },
        {
          "name": "channels",
          "type": "array",
          "required": true
        }
      ],
      "errors": [
        "ERR-4402",
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/webhooks",
      "summary": "Register a webhook",
      "params": [
        {
          "name": "url",
          "type": "string",
          "required": true
        },
        {
          "name": "events",
          "type": "array",
          "required": true
        },
        {
          "name": "secret",
          "type": "string",
          "required": false
        }
      ],
      "errors": [
        "ERR-4415",
        "ERR-6601"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/audit/events",
      "summary": "Query audit events",
      "params": [
        {
          "name": "from",
          "type": "string",
          "required": true
        },
        {
          "name": "to",
          "type": "string",
          "required": true
        },
        {
          "name": "actor",
          "type": "string",
          "required": false
        }
      ],
      "errors": [
        "ERR-6601"
      ]
    },
    {
      "method": "POST",
      "path": "/v2/scim/Users",
      "summary": "Provision a user (SCIM)",
      "params": [
        {
          "name": "userName",
          "type": "string",
          "required": true
        },
        {
          "name": "emails",
          "type": "array",
          "required": true
        }
      ],
      "errors": [
        "ERR-7733"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/queries/{query_id}/results",
      "summary": "Fetch SQL Workbench results",
      "params": [
        {
          "name": "query_id",
          "type": "string",
          "required": true
        },
        {
          "name": "cursor",
          "type": "string",
          "required": false
        }
      ],
      "errors": [
        "ERR-5501",
        "ERR-6601"
      ]
    }
  ]
}